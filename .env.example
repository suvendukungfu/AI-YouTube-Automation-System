# ==============================================================================
# CurioSphere AI YouTube Automation System - Environment Configuration
# ==============================================================================

# PostgreSQL Database Connection URL (Required for API Server & DB persistence)
# Example local PostgreSQL: postgresql://postgres:postgres@localhost:5432/curiosphere_db
# Example Neon/Supabase: postgresql://user:password@ep-xyz.aws.neon.tech/curiosphere_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curiosphere_db

# API Server Port (Default: 3000)
PORT=3000

# Local AI Provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# YouTube Data API v3 OAuth 2.0 Credentials (Optional for local testing / deterministic mock)
# YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your_client_secret
# YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
